@page
@model Stefanescu_Dimitrie_Lab2.Pages.Categories.DeleteModel
@{ ViewData["Title"] = "Delete Categories"; }
<h1>Delete Categories</h1>
<dl class="row"><dt class="col-sm-2">Category Name</dt><dd class="col-sm-10">@Model.Category.CategoryName</dd></dl>
<p>Delete this category? Its book assignments will also be removed; the books remain.</p>
<form method="post"><input type="hidden" asp-for="Category.ID" /><button class="btn btn-danger" type="submit">Delete</button></form>
<a asp-page="Index">Back to List</a>
