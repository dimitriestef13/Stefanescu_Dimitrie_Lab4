@page
@model Stefanescu_Dimitrie_Lab2.Pages.Borrowings.IndexModel
@{ ViewData["Title"] = "Borrowings"; }
<h1>Borrowings</h1>
<p><a asp-page="./Create">Create New</a></p><table class="table"><thead><tr><th>Member</th><th>Book</th><th>Author</th><th>Return Date</th><th></th></tr></thead><tbody>
@foreach(var item in Model.Items) { <tr><td>@(item.Member?.DisplayName ?? "Membru indisponibil")</td><td>@(item.Book?.Title ?? "Carte indisponibilă")</td><td>@(item.Book?.Author?.FullName ?? "Fără autor")</td><td>@item.ReturnDate.ToString("yyyy-MM-dd")</td><td><a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> | <a asp-page="./Details" asp-route-id="@item.ID">Details</a> | <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a></td></tr> }
</tbody></table>