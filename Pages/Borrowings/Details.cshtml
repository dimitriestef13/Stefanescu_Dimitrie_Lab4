@page
@model Stefanescu_Dimitrie_Lab2.Pages.Borrowings.DetailsModel
@{ ViewData["Title"] = "Details Borrowing"; }
<h1>Details Borrowing</h1>
<dl class="row"><dt>Member</dt><dd>@(Model.Borrowing.Member?.DisplayName ?? "Membru indisponibil")</dd><dt>Book</dt><dd>@(Model.Borrowing.Book?.Title ?? "Carte indisponibilă")</dd><dt>Author</dt><dd>@(Model.Borrowing.Book?.Author?.FullName ?? "Fără autor")</dd><dt>Return Date</dt><dd>@Model.Borrowing.ReturnDate.ToString("yyyy-MM-dd")</dd></dl><a asp-page="./Edit" asp-route-id="@Model.Borrowing.ID">Edit</a> | <a asp-page="./Index">Back to List</a>
