@page
@model Stefanescu_Dimitrie_Lab2.Pages.BookPages.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Book</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Book.Title)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Book.Title)
        </dd>
        <dt class="col-sm-2">
    Author Name
</dt>
<dd class="col-sm-10">
    @(Model.Book.Author != null
        ? Model.Book.Author.FirstName + " " + Model.Book.Author.LastName
        : "Fără autor")
</dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Book.Price)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Book.Price)
        </dd>
         <dt class="col-sm-2">
 @Html.DisplayNameFor(model => model.Book.PublishingDate)
 </dt>
 <dd class="col-sm-10">
 @Html.DisplayFor(model => model.Book.PublishingDate)
 </dd>
        <dt class="col-sm-2">Publisher</dt>
        <dd class="col-sm-10">@(Model.Book.Publisher?.PublisherName ?? "Fără editură")</dd>
        <dt class="col-sm-2">Categories</dt>
        <dd class="col-sm-10">
            @foreach (var category in Model.Book.BookCategories.OrderBy(x => x.Category.CategoryName))
            {
                <span>@category.Category.ID @category.Category.CategoryName</span><br />
            }
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Book.ID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
